# Template only. Copy to .env on the protected server and replace all secrets.
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false
GUNICORN_BIND=0.0.0.0:5000
MAX_WORKERS=2

CORS_ORIGINS=https://vodc.ru,https://www.vodc.ru
TRUSTED_PAGE_HOSTS=vodc.ru,www.vodc.ru
SIGNING_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

SESSION_TTL_SECONDS=7200
TRANSCRIPT_RETENTION_DAYS=90
MODEL_BASE_URLS=http://vllm-primary:8000,http://vllm-secondary:8000
CHAT_MODEL=Qwen3.5-9B
EMBEDDING_BASE_URL=http://vllm-embedding:8000
EMBEDDING_MODEL=Qwen3-Embedding-0.6B

MEDANGEL_API_URL=https://REPLACE_WITH_TESTED_MEDANGEL_HOST
MEDANGEL_API_KEY=REPLACE_WITH_SECRET
MEDANGEL_SERVICES_PATH=/services
MEDANGEL_DOCTORS_PATH=/doctors
MEDANGEL_SLOTS_PATH=/schedule
VODC_APPOINTMENT_URL=https://vodc.ru/appointment/

YANDEX_METRIKA_ID=
LOG_LEVEL=INFO
VLLM_IMAGE=vllm/vllm-openai:v0.22.0
CHAT_MODEL_PATH=Qwen/Qwen3.5-9B
CHAT_MODEL_REVISION=c202236235762e1c871ad0ccb60c8ee5ba337b9a
EMBEDDING_MODEL_PATH=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_MODEL_REVISION=97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=10
VLLM_PRIMARY_GPU_UTILIZATION=0.82
VLLM_SECONDARY_GPU_UTILIZATION=0.90
EMBEDDING_MAX_MODEL_LEN=8192
EMBEDDING_GPU_UTILIZATION=0.12
VLLM_START_PERIOD=10m
VLLM_PRIMARY_PORT=8000
VLLM_SECONDARY_PORT=8002
VLLM_EMBEDDING_PORT=8001
MODEL_TTFT_LIMIT_SECONDS=10

DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.6.0-4.8.3-distroless
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
GRAFANA_PORT=3000
DEPLOY_WAIT_TIMEOUT_SECONDS=1800
ENABLE_GPU_PROFILE=true
